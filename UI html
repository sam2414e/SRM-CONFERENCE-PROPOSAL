<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ETCSIS 2027 – SRM Tiruchirappalli</title>
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --srm-navy: #003478;
    --srm-gold: #C8922A;
    --srm-red:  #A81F28;
    --white:    #ffffff;
    --off:      #f5f7fa;
    --text:     #1a1a2e;
    --muted:    #5a607a;
    --border:   #d0d8e8;
    --font-head: 'Georgia', 'Times New Roman', serif;
    --font-body: 'Segoe UI', Arial, sans-serif;
  }

  html { scroll-behavior: smooth; }

  body {
    font-family: var(--font-body);
    color: var(--text);
    background: var(--white);
    font-size: 15px;
    line-height: 1.65;
  }

  /* ── TOP BAR ── */
  .topbar {
    background: var(--srm-navy);
    color: #c8d8f0;
    font-size: 12px;
    padding: 6px 32px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .topbar a { color: var(--srm-gold); text-decoration: none; }

  /* ── HEADER ── */
  header {
    background: var(--white);
    border-bottom: 3px solid var(--srm-navy);
    padding: 18px 32px;
    display: flex;
    align-items: center;
    gap: 24px;
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
  }

  .logo-box {
    width: 80px;
    height: 80px;
    background: var(--off);
    border: 2px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-size: 10px;
    color: var(--muted);
    text-align: center;
    line-height: 1.3;
    font-style: italic;
  }

  .header-text h1 {
    font-family: var(--font-head);
    font-size: 18px;
    color: var(--srm-navy);
    font-weight: 700;
    letter-spacing: 0.01em;
    line-height: 1.3;
  }
  .header-text p {
    font-size: 12px;
    color: var(--muted);
    margin-top: 3px;
  }

  .conf-badge {
    margin-left: auto;
    text-align: right;
    flex-shrink: 0;
  }
  .conf-badge .abbr {
    font-family: var(--font-head);
    font-size: 22px;
    font-weight: 700;
    color: var(--srm-red);
    letter-spacing: 1px;
  }
  .conf-badge .dates {
    font-size: 12px;
    color: var(--muted);
    margin-top: 2px;
  }

  /* ── NAV ── */
  nav {
    background: var(--srm-navy);
    display: flex;
    overflow-x: auto;
    padding: 0 24px;
  }
  nav a {
    color: #b8cde8;
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    padding: 13px 18px;
    white-space: nowrap;
    border-bottom: 3px solid transparent;
    transition: color 0.2s, border-color 0.2s;
    letter-spacing: 0.03em;
  }
  nav a:hover, nav a.active {
    color: var(--white);
    border-bottom-color: var(--srm-gold);
  }

  /* ── PAGE SYSTEM ── */
  .page { display: none; }
  .page.active { display: block; }

  /* ── HERO ── */
  .hero {
    background: linear-gradient(135deg, var(--srm-navy) 0%, #01245a 60%, #001a42 100%);
    color: var(--white);
    padding: 60px 32px 50px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: repeating-linear-gradient(
      -45deg,
      transparent,
      transparent 40px,
      rgba(255,255,255,0.015) 40px,
      rgba(255,255,255,0.015) 80px
    );
    pointer-events: none;
  }
  .hero-tag {
    display: inline-block;
    background: var(--srm-gold);
    color: var(--srm-navy);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 5px 16px;
    margin-bottom: 22px;
  }
  .hero h2 {
    font-family: var(--font-head);
    font-size: clamp(20px, 3.5vw, 34px);
    font-weight: 700;
    line-height: 1.3;
    max-width: 860px;
    margin: 0 auto 16px;
  }
  .hero .sub {
    color: #a0b8d8;
    font-size: 16px;
    margin-bottom: 28px;
  }
  .hero .meta-row {
    display: flex;
    justify-content: center;
    gap: 32px;
    flex-wrap: wrap;
    margin-bottom: 32px;
  }
  .hero .meta-item {
    text-align: center;
  }
  .hero .meta-item .label {
    font-size: 10px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #7899bb;
    margin-bottom: 4px;
  }
  .hero .meta-item .value {
    font-size: 15px;
    font-weight: 600;
    color: var(--srm-gold);
  }
  .hero-btns {
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .btn {
    display: inline-block;
    padding: 11px 28px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-decoration: none;
    cursor: pointer;
    border: 2px solid transparent;
    transition: 0.2s;
  }
  .btn-primary { background: var(--srm-gold); color: var(--srm-navy); border-color: var(--srm-gold); }
  .btn-primary:hover { background: #b07a20; border-color: #b07a20; }
  .btn-outline { background: transparent; color: var(--white); border-color: rgba(255,255,255,0.4); }
  .btn-outline:hover { border-color: var(--white); }

  /* ── SECTION COMMON ── */
  .section {
    padding: 52px 32px;
    max-width: 1100px;
    margin: 0 auto;
  }
  .section-full {
    padding: 52px 32px;
  }
  .section-alt { background: var(--off); }

  .section-label {
    font-size: 10px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--srm-gold);
    font-weight: 700;
    margin-bottom: 6px;
  }
  .section-title {
    font-family: var(--font-head);
    font-size: clamp(20px, 2.5vw, 28px);
    color: var(--srm-navy);
    font-weight: 700;
    margin-bottom: 6px;
  }
  .section-rule {
    width: 48px;
    height: 3px;
    background: var(--srm-gold);
    margin-bottom: 28px;
  }

  /* ── DATES BAND ── */
  .dates-band {
    background: var(--srm-red);
    color: var(--white);
    padding: 22px 32px;
    display: flex;
    justify-content: center;
    gap: 40px;
    flex-wrap: wrap;
  }
  .date-item {
    text-align: center;
  }
  .date-item .d-label {
    font-size: 10px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: rgba(255,255,255,0.7);
    margin-bottom: 4px;
  }
  .date-item .d-val {
    font-size: 15px;
    font-weight: 700;
  }

  /* ── ABOUT GRID ── */
  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }
  @media (max-width: 700px) {
    .two-col { grid-template-columns: 1fr; }
    nav a { padding: 12px 12px; font-size: 12px; }
    header { flex-wrap: wrap; }
    .conf-badge { margin-left: 0; }
    .topbar { flex-direction: column; gap: 4px; }
  }

  /* ── CARD ── */
  .card {
    border: 1px solid var(--border);
    padding: 24px;
    background: var(--white);
  }
  .card h3 {
    font-family: var(--font-head);
    font-size: 17px;
    color: var(--srm-navy);
    margin-bottom: 10px;
  }
  .card p, .card li { color: var(--muted); font-size: 14px; }
  .card ul { padding-left: 18px; }
  .card ul li { margin-bottom: 4px; }

  /* ── TRACKS GRID ── */
  .tracks-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
    margin-top: 8px;
  }
  .track-card {
    border: 1px solid var(--border);
    padding: 20px;
    background: var(--white);
  }
  .track-num {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    color: var(--srm-gold);
    margin-bottom: 6px;
  }
  .track-card h4 {
    font-size: 14px;
    font-weight: 700;
    color: var(--srm-navy);
    margin-bottom: 10px;
  }
  .track-card ul {
    list-style: none;
    padding: 0;
  }
  .track-card ul li {
    font-size: 12.5px;
    color: var(--muted);
    padding: 3px 0;
    border-bottom: 1px solid var(--off);
  }
  .track-card ul li:last-child { border-bottom: none; }
  .track-card ul li::before {
    content: '— ';
    color: var(--srm-gold);
    font-weight: 700;
  }

  /* ── SPEAKERS ── */
  .speakers-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
  }
  .speaker-card {
    border: 1px solid var(--border);
    padding: 20px;
    background: var(--white);
  }
  .speaker-card .spk-avatar {
    width: 56px;
    height: 56px;
    background: var(--off);
    border: 1px solid var(--border);
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 9px;
    color: var(--muted);
    font-style: italic;
    text-align: center;
  }
  .speaker-card h4 {
    font-size: 14px;
    font-weight: 700;
    color: var(--srm-navy);
    margin-bottom: 4px;
  }
  .speaker-card .spk-org {
    font-size: 12px;
    color: var(--muted);
    margin-bottom: 6px;
    line-height: 1.4;
  }
  .spk-tag {
    display: inline-block;
    background: var(--off);
    border: 1px solid var(--border);
    font-size: 10px;
    padding: 2px 8px;
    color: var(--srm-navy);
    font-weight: 600;
    letter-spacing: 0.5px;
  }
  .spk-expertise {
    font-size: 11.5px;
    color: var(--muted);
    margin-top: 8px;
    font-style: italic;
    line-height: 1.4;
  }

  /* ── COMMITTEE TABLE ── */
  .cmte-section { margin-bottom: 36px; }
  .cmte-title {
    font-weight: 700;
    letter-spacing: 0.5px;
    color: var(--srm-navy);
    border-left: 4px solid var(--srm-gold);
    padding-left: 12px;
    margin-bottom: 12px;
    text-transform: uppercase;
    font-size: 12px;
  }
  .cmte-list {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 8px;
  }
  .cmte-list li {
    font-size: 13px;
    color: var(--text);
    padding: 8px 12px;
    border: 1px solid var(--border);
    background: var(--white);
  }
  .cmte-list li span {
    display: block;
    font-size: 11px;
    color: var(--muted);
    margin-top: 2px;
  }

  /* ── REGISTRATION TABLE ── */
  .reg-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 16px;
    font-size: 14px;
  }
  .reg-table th {
    background: var(--srm-navy);
    color: var(--white);
    padding: 11px 14px;
    text-align: left;
    font-size: 12px;
    letter-spacing: 0.5px;
    font-weight: 700;
  }
  .reg-table td {
    padding: 10px 14px;
    border-bottom: 1px solid var(--border);
  }
  .reg-table tr:nth-child(even) td { background: var(--off); }
  .reg-table .highlight { font-weight: 700; color: var(--srm-navy); }
  .early-note {
    margin-top: 12px;
    padding: 12px 16px;
    background: #fff8e6;
    border-left: 4px solid var(--srm-gold);
    font-size: 13px;
    color: var(--text);
  }

  /* ── SCHEDULE ── */
  .schedule-day {
    margin-bottom: 32px;
  }
  .day-header {
    background: var(--srm-navy);
    color: var(--white);
    padding: 12px 20px;
    font-size: 14px;
    font-weight: 700;
    margin-bottom: 0;
  }
  .schedule-row {
    display: flex;
    border-bottom: 1px solid var(--border);
    font-size: 13.5px;
  }
  .schedule-row:last-child { border-bottom: none; }
  .sch-time {
    width: 160px;
    flex-shrink: 0;
    padding: 10px 14px;
    color: var(--srm-navy);
    font-weight: 600;
    font-size: 12.5px;
    background: var(--off);
    border-right: 1px solid var(--border);
  }
  .sch-event {
    padding: 10px 16px;
    flex: 1;
    color: var(--text);
  }
  .sch-break {
    background: #f0f4ff;
    color: var(--muted);
    font-style: italic;
  }
  .sch-break .sch-event { color: var(--muted); }

  /* ── SUBMISSION PROCESS ── */
  .process-steps {
    counter-reset: steps;
    list-style: none;
    padding: 0;
  }
  .process-steps li {
    counter-increment: steps;
    display: flex;
    gap: 16px;
    margin-bottom: 18px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--border);
    align-items: flex-start;
  }
  .process-steps li:last-child { border-bottom: none; }
  .process-steps li::before {
    content: counter(steps);
    background: var(--srm-navy);
    color: var(--white);
    font-size: 13px;
    font-weight: 700;
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 1px;
  }
  .process-steps li div {
    flex: 1;
  }
  .process-steps li strong {
    display: block;
    color: var(--srm-navy);
    margin-bottom: 3px;
    font-size: 14px;
  }
  .process-steps li p {
    color: var(--muted);
    font-size: 13px;
  }

  /* ── CONTACT ── */
  .contact-box {
    border: 1px solid var(--border);
    padding: 28px;
    background: var(--white);
    max-width: 480px;
  }
  .contact-box h3 {
    font-family: var(--font-head);
    font-size: 17px;
    color: var(--srm-navy);
    margin-bottom: 14px;
  }
  .contact-row {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    margin-bottom: 10px;
    font-size: 13.5px;
  }
  .contact-icon {
    font-size: 15px;
    width: 20px;
    flex-shrink: 0;
    margin-top: 1px;
  }
  .contact-row a { color: var(--srm-navy); }

  /* ── FOOTER ── */
  footer {
    background: var(--srm-navy);
    color: #a0b8d8;
    padding: 32px;
    text-align: center;
    font-size: 13px;
    margin-top: 40px;
  }
  footer strong { color: var(--white); }
  footer .foot-links {
    margin-top: 10px;
    display: flex;
    justify-content: center;
    gap: 24px;
    flex-wrap: wrap;
  }
  footer .foot-links a {
    color: #a0b8d8;
    text-decoration: none;
    font-size: 12px;
    cursor: pointer;
  }
  footer .foot-links a:hover { color: var(--srm-gold); }

  /* ── ADVISORY ── */
  .advisory-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  @media (max-width: 600px) {
    .advisory-cols { grid-template-columns: 1fr; }
    .two-col { grid-template-columns: 1fr; }
  }
  .adv-item {
    border: 1px solid var(--border);
    padding: 10px 14px;
    font-size: 13px;
    color: var(--text);
    background: var(--white);
  }
  .adv-item span {
    display: block;
    font-size: 11px;
    color: var(--muted);
    margin-top: 2px;
  }

  /* misc */
  p + p { margin-top: 10px; }
  .text-content p { color: var(--muted); font-size: 14px; margin-bottom: 10px; }
  .text-content p:last-child { margin-bottom: 0; }
  .notice {
    background: #e8f0fe;
    border-left: 4px solid var(--srm-navy);
    padding: 14px 18px;
    font-size: 13.5px;
    color: var(--text);
    margin-top: 20px;
  }
  .inline-link {
    color: var(--srm-navy);
    font-weight: 600;
  }
  .pub-card {
    border: 1px solid var(--border);
    padding: 20px 24px;
    background: var(--white);
    margin-bottom: 16px;
  }
  .pub-card h4 { font-size: 15px; color: var(--srm-navy); margin-bottom: 6px; }
  .pub-card p { font-size: 13px; color: var(--muted); }
  .award-box {
    border: 1px solid var(--srm-gold);
    padding: 20px 24px;
    background: #fffbf0;
    margin-bottom: 16px;
  }
  .award-box h4 { font-size: 15px; color: var(--srm-navy); margin-bottom: 6px; }
  .award-box p { font-size: 13px; color: var(--muted); }
</style>
</head>
